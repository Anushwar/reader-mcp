# All settings are optional. Copy to .env and run:  uv run --env-file .env reader --http
# (MCP clients can instead pass these in the "env" block of their server config.)

# Where ingested documents and extracted text are stored.
READER_DATA_DIR=~/.reader-mcp

# Folders the `path` input may read, separated by ":" (";" on Windows).
# Default: your home folder in stdio mode, disabled in --http mode.
READER_ALLOWED_ROOTS=

# Largest accepted file, in MB.
READER_MAX_FILE_MB=2048

# Seconds before a single extraction is killed.
READER_EXTRACT_TIMEOUT=600

# Delete ingested documents after this many hours (0 = keep forever).
READER_RETENTION_HOURS=24

# --- HTTP mode only -------------------------------------------------------------
# Base URL clients use to reach this server (used in upload links).
READER_PUBLIC_URL=

# Key that signs upload links. Default: generated once and kept in READER_DATA_DIR/upload_secret (owner-only).
# Set it only to share one key across servers or to rotate it (rotating invalidates outstanding links).
READER_UPLOAD_SECRET=

# Seconds an upload link stays valid.
READER_UPLOAD_TTL=3600

# If set, clients must send "Authorization: Bearer <token>" to /mcp.
READER_AUTH_TOKEN=
